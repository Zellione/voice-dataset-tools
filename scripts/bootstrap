#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." \
    && pwd
)"

TOOLS_DIR="${ROOT_DIR}/tools"

ECAPA_DIR="${TOOLS_DIR}/ecapa"
ECAPA_VENV="${ECAPA_DIR}/.venv"

PYANNOTE_DIR="${TOOLS_DIR}/pyannote"
PYANNOTE_VENV="${PYANNOTE_DIR}/.venv"

mkdir -p "${TOOLS_DIR}"

echo "voice-dataset-tools bootstrap"
echo "project: ${ROOT_DIR}"
echo "tools:   ${TOOLS_DIR}"
echo

if ! command -v uv >/dev/null 2>&1; then
    echo "error: uv is required but was not found" >&2
    exit 1
fi

echo "==> ECAPA"

mkdir -p "${ECAPA_DIR}"

if [[ ! -x "${ECAPA_VENV}/bin/python" ]]; then
    echo "Creating ECAPA Python environment..."

    uv venv \
        --python 3.12 \
        "${ECAPA_VENV}"
else
    echo "ECAPA Python environment already exists."
fi

echo "Installing ECAPA dependencies..."

uv pip install \
    --python "${ECAPA_VENV}/bin/python" \
    "speechbrain==1.1.1" \
    "torch==2.14.0" \
    "torchaudio==2.11.0" \
    "torchcodec==0.16.0" \
    "numpy==2.5.3" \
    "soundfile==0.14.0" \
    "huggingface-hub==1.32.0"

echo
echo "==> Pyannote / WeSpeaker"

mkdir -p "${PYANNOTE_DIR}"

if [[ ! -x "${PYANNOTE_VENV}/bin/python" ]]; then
    echo "Creating Pyannote Python environment..."

    uv venv \
        --python 3.12 \
        "${PYANNOTE_VENV}"
else
    echo "Pyannote Python environment already exists."
fi

echo "Installing Pyannote / WeSpeaker dependencies..."

uv pip install \
    --python "${PYANNOTE_VENV}/bin/python" \
    "pyannote-audio==4.0.7" \
    "torch==2.14.0" \
    "torchaudio==2.11.0" \
    "torchcodec==0.16.0" \
    "numpy==2.5.3" \
    "soundfile==0.14.0" \
    "huggingface-hub==1.32.0" \
    "safetensors==0.8.0" \
    "lightning==2.6.6" \
    "asteroid-filterbanks==0.4.0"

echo
echo "Bootstrap complete."
