#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." \
    && pwd
)"

TOOLS_DIR="${ROOT_DIR}/tools"

TOOL_LOCKS_DIR="${ROOT_DIR}/tool-locks"

ECAPA_LOCK="${TOOL_LOCKS_DIR}/ecapa.txt"
PYANNOTE_LOCK="${TOOL_LOCKS_DIR}/pyannote.txt"
BANDIT_LOCK="${TOOL_LOCKS_DIR}/bandit.txt"

ECAPA_DIR="${TOOLS_DIR}/ecapa"
ECAPA_VENV="${ECAPA_DIR}/.venv"
ECAPA_MODEL_ID="speechbrain/spkrec-ecapa-voxceleb"
ECAPA_MODEL_REVISION="0f99f2d0ebe89ac095bcc5903c4dd8f72b367286"
ECAPA_MODEL_DIR="${ECAPA_DIR}/models/spkrec-ecapa-voxceleb"

ECAPA_CLASSIFIER_SHA256="fd9e3634fe68bd0a427c95e354c0c677374f62b3f434e45b78599950d860d535"
ECAPA_EMBEDDING_SHA256="0575cb64845e6b9a10db9bcb74d5ac32b326b8dc90352671d345e2ee3d0126a2"
ECAPA_HYPERPARAMS_SHA256="6f78854fa04ba59e761437b76a2575d3aba5e5016de3e9b69f0c9a5077fb1a41"
ECAPA_LABEL_ENCODER_SHA256="e13c3a167bb4112685670ee896d20e2b565af16b3a4ceeaa8689fa4d22adb8b9"
ECAPA_MEAN_VAR_NORM_SHA256="cd70225b05b37be64fc5a95e24395d804231d43f74b2e1e5a513db7b69b34c33"

PYANNOTE_DIR="${TOOLS_DIR}/pyannote"
PYANNOTE_VENV="${PYANNOTE_DIR}/.venv"

WESPEAKER_MODEL_ID="pyannote/wespeaker-voxceleb-resnet34-LM"
WESPEAKER_MODEL_REVISION="837717ddb9ff5507820346191109dc79c958d614"
WESPEAKER_MODEL_DIR="${PYANNOTE_DIR}/models/wespeaker-voxceleb-resnet34-LM"
WESPEAKER_MODEL_PATH="${WESPEAKER_MODEL_DIR}/pytorch_model.bin"
WESPEAKER_MODEL_SHA256="366edf44f4c80889a3eb7a9d7bdf02c4aede3127f7dd15e274dcdb826b143c56"

COMMUNITY_MODEL_ID="pyannote/speaker-diarization-community-1"
COMMUNITY_MODEL_REVISION="3533c8cf8e369892e6b79ff1bf80f7b0286a54ee"
COMMUNITY_MODEL_DIR="${PYANNOTE_DIR}/models/speaker-diarization-community-1"

BANDIT_DIR="${TOOLS_DIR}/bandit"
BANDIT_SOURCE_DIR="${BANDIT_DIR}/source"
BANDIT_VENV="${BANDIT_DIR}/.venv"
BANDIT_MODEL_DIR="${BANDIT_DIR}/models"

BANDIT_REPOSITORY="https://github.com/wolfram0108/bandit-v2-Wolfram.git"
BANDIT_REVISION="e6bdc5bf56abc10d72f09fb6214c224e0da5864b"

BANDIT_MODEL_URL="https://zenodo.org/api/records/12701995/files/checkpoint-multi.ckpt/content"
BANDIT_MODEL_PATH="${BANDIT_MODEL_DIR}/checkpoint-multi.ckpt"
BANDIT_MODEL_SHA256="abcfccf65446752a057f4a302c941479a54b7560ebf8d7bca039d2ea98e64cfc"

for lock_file in \
    "${ECAPA_LOCK}" \
    "${PYANNOTE_LOCK}" \
    "${BANDIT_LOCK}"
do
    if [[ ! -f "${lock_file}" ]]; then
        echo "Required tool lock does not exist: ${lock_file}" >&2
        exit 1
    fi
done

mkdir -p "${TOOLS_DIR}"

echo "voice-dataset-tools bootstrap"
echo "project: ${ROOT_DIR}"
echo "tools:   ${TOOLS_DIR}"
echo

if ! command -v uv >/dev/null 2>&1; then
    echo "error: uv is required but was not found" >&2
    exit 1
fi

echo "==> ECAPA"

mkdir -p "${ECAPA_DIR}"

if [[ ! -x "${ECAPA_VENV}/bin/python" ]]; then
    echo "Creating ECAPA Python environment..."

    uv venv \
        --python 3.12 \
        "${ECAPA_VENV}"
else
    echo "ECAPA Python environment already exists."
fi

echo "Installing locked ECAPA dependencies..."

uv pip install \
    --python "${ECAPA_VENV}/bin/python" \
    --requirement "${ECAPA_LOCK}"

echo "Checking ECAPA model..."

ECAPA_CLASSIFIER="${ECAPA_MODEL_DIR}/classifier.ckpt"
ECAPA_EMBEDDING="${ECAPA_MODEL_DIR}/embedding_model.ckpt"
ECAPA_HYPERPARAMS="${ECAPA_MODEL_DIR}/hyperparams.yaml"
ECAPA_LABEL_ENCODER="${ECAPA_MODEL_DIR}/label_encoder.txt"
ECAPA_MEAN_VAR_NORM="${ECAPA_MODEL_DIR}/mean_var_norm_emb.ckpt"

ecapa_model_valid=true

check_ecapa_file() {
    local path="$1"
    local expected_sha256="$2"

    if [[ ! -f "${path}" ]]; then
        ecapa_model_valid=false
        return
    fi

    local actual_sha256
    actual_sha256="$(
        sha256sum "${path}" |
        awk '{print $1}'
    )"

    if [[ "${actual_sha256}" != "${expected_sha256}" ]]; then
        ecapa_model_valid=false
    fi
}

check_ecapa_file \
    "${ECAPA_CLASSIFIER}" \
    "${ECAPA_CLASSIFIER_SHA256}"

check_ecapa_file \
    "${ECAPA_EMBEDDING}" \
    "${ECAPA_EMBEDDING_SHA256}"

check_ecapa_file \
    "${ECAPA_HYPERPARAMS}" \
    "${ECAPA_HYPERPARAMS_SHA256}"

check_ecapa_file \
    "${ECAPA_LABEL_ENCODER}" \
    "${ECAPA_LABEL_ENCODER_SHA256}"

check_ecapa_file \
    "${ECAPA_MEAN_VAR_NORM}" \
    "${ECAPA_MEAN_VAR_NORM_SHA256}"

if [[ "${ecapa_model_valid}" == true ]]; then
    echo "ECAPA model already exists and is valid."
else
    echo "Downloading pinned ECAPA model..."

    rm -rf "${ECAPA_MODEL_DIR}"
    mkdir -p "$(dirname "${ECAPA_MODEL_DIR}")"

    "${ECAPA_VENV}/bin/hf" download \
        "${ECAPA_MODEL_ID}" \
        --revision "${ECAPA_MODEL_REVISION}" \
        --local-dir "${ECAPA_MODEL_DIR}"

    ecapa_model_valid=true

    check_ecapa_file \
        "${ECAPA_CLASSIFIER}" \
        "${ECAPA_CLASSIFIER_SHA256}"

    check_ecapa_file \
        "${ECAPA_EMBEDDING}" \
        "${ECAPA_EMBEDDING_SHA256}"

    check_ecapa_file \
        "${ECAPA_HYPERPARAMS}" \
        "${ECAPA_HYPERPARAMS_SHA256}"

    check_ecapa_file \
        "${ECAPA_LABEL_ENCODER}" \
        "${ECAPA_LABEL_ENCODER_SHA256}"

    check_ecapa_file \
        "${ECAPA_MEAN_VAR_NORM}" \
        "${ECAPA_MEAN_VAR_NORM_SHA256}"

    if [[ "${ecapa_model_valid}" != true ]]; then
        echo "ECAPA model verification failed." >&2
        exit 1
    fi

    echo "ECAPA model downloaded and verified."
fi

echo
echo "==> Pyannote / WeSpeaker"

mkdir -p "${PYANNOTE_DIR}"

if [[ ! -x "${PYANNOTE_VENV}/bin/python" ]]; then
    echo "Creating Pyannote Python environment..."

    uv venv \
        --python 3.12 \
        "${PYANNOTE_VENV}"
else
    echo "Pyannote Python environment already exists."
fi

echo "Installing locked Pyannote / WeSpeaker dependencies..."

uv pip install \
    --python "${PYANNOTE_VENV}/bin/python" \
    --requirement "${PYANNOTE_LOCK}"

echo "Checking WeSpeaker model..."

wespeaker_model_valid=false

if [[ -f "${WESPEAKER_MODEL_PATH}" ]]; then
    wespeaker_actual_sha256="$(
        sha256sum "${WESPEAKER_MODEL_PATH}" |
        awk '{print $1}'
    )"

    if [[ "${wespeaker_actual_sha256}" == "${WESPEAKER_MODEL_SHA256}" ]]; then
        wespeaker_model_valid=true
    fi
fi

if [[ "${wespeaker_model_valid}" == true ]]; then
    echo "WeSpeaker model already exists and is valid."
else
    echo "Downloading pinned WeSpeaker model..."

    rm -rf "${WESPEAKER_MODEL_DIR}"
    mkdir -p "${WESPEAKER_MODEL_DIR}"

    "${PYANNOTE_VENV}/bin/hf" download \
        "${WESPEAKER_MODEL_ID}" \
        pytorch_model.bin \
        --revision "${WESPEAKER_MODEL_REVISION}" \
        --local-dir "${WESPEAKER_MODEL_DIR}"

    if [[ ! -f "${WESPEAKER_MODEL_PATH}" ]]; then
        echo "WeSpeaker model download failed." >&2
        exit 1
    fi

    wespeaker_actual_sha256="$(
        sha256sum "${WESPEAKER_MODEL_PATH}" |
        awk '{print $1}'
    )"

    if [[ "${wespeaker_actual_sha256}" != "${WESPEAKER_MODEL_SHA256}" ]]; then
        echo "WeSpeaker model verification failed." >&2
        exit 1
    fi

    echo "WeSpeaker model downloaded and verified."
fi

echo
echo "==> Pyannote Community-1"

COMMUNITY_CONFIG="${COMMUNITY_MODEL_DIR}/config.yaml"
COMMUNITY_SEGMENTATION="${COMMUNITY_MODEL_DIR}/segmentation/pytorch_model.bin"
COMMUNITY_EMBEDDING="${COMMUNITY_MODEL_DIR}/embedding/pytorch_model.bin"
COMMUNITY_PLDA="${COMMUNITY_MODEL_DIR}/plda/plda.npz"
COMMUNITY_XVEC="${COMMUNITY_MODEL_DIR}/plda/xvec_transform.npz"

community_model_complete=true

for file in \
    "${COMMUNITY_CONFIG}" \
    "${COMMUNITY_SEGMENTATION}" \
    "${COMMUNITY_EMBEDDING}" \
    "${COMMUNITY_PLDA}" \
    "${COMMUNITY_XVEC}"
do
    if [[ ! -f "${file}" ]]; then
        community_model_complete=false
        break
    fi
done

if [[ "${community_model_complete}" == true ]]; then
    echo "Community-1 model already exists."
else
    echo "Downloading Community-1 model..."

    rm -rf "${COMMUNITY_MODEL_DIR}"
    mkdir -p "$(dirname "${COMMUNITY_MODEL_DIR}")"

    if ! "${PYANNOTE_VENV}/bin/hf" download \
        "${COMMUNITY_MODEL_ID}" \
        --revision "${COMMUNITY_MODEL_REVISION}" \
        --local-dir "${COMMUNITY_MODEL_DIR}"
    then
        echo >&2
        echo "Failed to download Community-1." >&2
        echo "The model is gated and requires Hugging Face access." >&2
        echo "Accept its access conditions and authenticate with:" >&2
        echo "  ${PYANNOTE_VENV}/bin/hf auth login" >&2
        exit 1
    fi
fi

echo
echo "==> BandIt v2"

mkdir -p "${BANDIT_DIR}"

if [[ ! -d "${BANDIT_SOURCE_DIR}/.git" ]]; then
    echo "Cloning BandIt source..."

    rm -rf "${BANDIT_SOURCE_DIR}"

    git clone \
        "${BANDIT_REPOSITORY}" \
        "${BANDIT_SOURCE_DIR}"
else
    echo "BandIt source already exists."
fi

echo "Checking out pinned BandIt revision..."

git -C "${BANDIT_SOURCE_DIR}" fetch origin
git -C "${BANDIT_SOURCE_DIR}" checkout --detach "${BANDIT_REVISION}"

current_bandit_revision="$(
    git -C "${BANDIT_SOURCE_DIR}" rev-parse HEAD
)"

if [[ "${current_bandit_revision}" != "${BANDIT_REVISION}" ]]; then
    echo "BandIt revision verification failed." >&2
    exit 1
fi

if [[ ! -x "${BANDIT_VENV}/bin/python" ]]; then
    echo "Creating BandIt Python environment..."

    uv venv \
        --python 3.10 \
        "${BANDIT_VENV}"
else
    echo "BandIt Python environment already exists."
fi

echo "Installing locked BandIt dependencies..."

uv pip install \
    --python "${BANDIT_VENV}/bin/python" \
    --requirement "${BANDIT_LOCK}"

mkdir -p "${BANDIT_MODEL_DIR}"

bandit_model_valid=false

if [[ -f "${BANDIT_MODEL_PATH}" ]]; then
    actual_bandit_sha256="$(
        sha256sum "${BANDIT_MODEL_PATH}" |
        awk '{print $1}'
    )"

    if [[ "${actual_bandit_sha256}" == "${BANDIT_MODEL_SHA256}" ]]; then
        bandit_model_valid=true
    else
        echo "Existing BandIt checkpoint has wrong SHA-256."
    fi
fi

if [[ "${bandit_model_valid}" == true ]]; then
    echo "BandIt checkpoint already exists and is valid."
else
    echo "Downloading BandIt checkpoint..."

    temporary_bandit_model="${BANDIT_MODEL_PATH}.tmp"

    rm -f "${temporary_bandit_model}"

    if ! curl \
        -L \
        --fail \
        --progress-bar \
        -o "${temporary_bandit_model}" \
        "${BANDIT_MODEL_URL}"
    then
        rm -f "${temporary_bandit_model}"
        echo "Failed to download BandIt checkpoint." >&2
        exit 1
    fi

    actual_bandit_sha256="$(
        sha256sum "${temporary_bandit_model}" |
        awk '{print $1}'
    )"

    if [[ "${actual_bandit_sha256}" != "${BANDIT_MODEL_SHA256}" ]]; then
        rm -f "${temporary_bandit_model}"

        echo "BandIt checkpoint SHA-256 verification failed." >&2
        echo "Expected: ${BANDIT_MODEL_SHA256}" >&2
        echo "Actual:   ${actual_bandit_sha256}" >&2

        exit 1
    fi

    mv \
        "${temporary_bandit_model}" \
        "${BANDIT_MODEL_PATH}"
fi

echo
echo "Bootstrap complete."
