#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." \
    && pwd
)"

TOOLS_DIR="${ROOT_DIR}/tools"

mkdir -p "${TOOLS_DIR}"

echo "voice-dataset-tools bootstrap"
echo "project: ${ROOT_DIR}"
echo "tools:   ${TOOLS_DIR}"
echo
echo "No external tools configured yet."
